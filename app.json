{
  "expo": {
    "name": "Facecard",
    "slug": "facecard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "facecard",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E6F5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kleinma.facecard"
    },
    "android": {
      "package": "com.kleinma.facecard",
      "adaptiveIcon": {
        "backgroundColor": "#2E6F5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Facecard uses your photos so you can add pictures of the people in your deck. Photos stay on this device.",
          "cameraPermission": "Facecard uses your camera so you can take a photo of a person to add to your deck. Photos stay on this device."
        }
      ]
    ]
  }
}
